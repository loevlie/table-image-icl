{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug tests (steps into torch and tabicl)",
      "type": "debugpy",
      "request": "launch",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {"PYTHONPATH": "${workspaceFolder}"}
    },
    {
      "name": "train.py, a few steps on the CPU",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train.py",
      "args": ["--out", "runs/debug", "--encoder", "pixels", "--max-steps", "3", "--images-per-collection", "200", "--workers", "0", "--n-validation-batches", "2", "--validate-every", "2", "--image-cache", "cache"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {"PYTHONPATH": "${workspaceFolder}"}
    },
    {
      "name": "Code tour server (tour/app.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tour/app.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "django": true,
      "justMyCode": true
    }
  ]
}
