{
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.autoImportCompletions": true,
  "python.analysis.extraPaths": ["."],
  "python.analysis.inlayHints.functionReturnTypes": true,
  "python.analysis.inlayHints.callArgumentNames": "partial",
  "python.analysis.packageIndexDepths": [{"name": "torch", "depth": 3}, {"name": "tabicl", "depth": 3}],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],
  "python.debugpy.debugJustMyCode": false,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {"source.organizeImports.ruff": "explicit"}
  },
  "editor.inlayHints.enabled": "onUnlessPressed",
  "editor.stickyScroll.enabled": true,
  "breadcrumbs.enabled": true,
  "outline.showVariables": false,
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleReferences": "peek",
  "workbench.editor.enablePreview": true,
  "workbench.editor.revealIfOpen": true,
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "files.exclude": {"**/__pycache__": true, "tour/web/node_modules": true, "tour/web/dist": true}
}
